### JLC PCB Basic 4 Layer Board Rules
(version 1)

### VIAS
# Via Hole to Pad Clearance
(rule via_to_pad
	(condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pin_Name != 'NT1' && B.Pin_Name != 'NT2'")
	(constraint physical_hole_clearance (min 0.35mm)))

# Track to PTH Clearance
(rule track_to_pth
	(layer outer)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.35mm)))

# Expensive Vias Under 0.4mm
(rule bad_via_size_under_0_4mm
	(condition "A.Type == 'Via' && A.Diameter < 0.4mm")
	(constraint hole_size (min 0.3mm)))

# Expensive Vias 0.45mm And Above
(rule bad_via_size_0_45mm_over
	(condition "A.Type == 'Via' && A.Diameter >= 0.45mm")
	(constraint hole_size (min 0.2mm)))
